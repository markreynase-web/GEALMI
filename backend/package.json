{
  "name": "gealmi-backend",
  "version": "1.0.0",
  "description": "API de GEALMI: recibe datos del formulario y de importación CSV, y los persiste en PostgreSQL.",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/migrate.js",
    "seed:admin": "node src/seedAdmin.js",
    "seed:superadmin": "node src/seedSuperAdmin.js",
    "test": "node --test --test-concurrency=2",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "papaparse": "^5.4.1",
    "pg": "^8.12.0",
    "pino": "^10.3.1"
  }
}
